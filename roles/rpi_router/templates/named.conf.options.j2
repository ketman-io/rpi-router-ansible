// Managed by rpi_router (Ansible). Native BIND DNS-over-TLS — no Stubby,
// no local proxy of any kind between BIND and its upstream resolvers.
//
// Each provider gets its own `tls` profile keyed to ITS OWN tls_hostname,
// and each of that provider's addresses is bound to that profile
// individually in the forwarders list below (BIND 9.18+ supports a
// per-address port/tls suffix in one forwarders statement). That per-address
// binding is what keeps a Cloudflare address from ever being checked
// against Google's certificate name or vice versa — sharing one TLS
// profile across providers would defeat the point of remote-hostname
// checking.
{% for provider in dns_upstream_providers %}
tls dot-{{ provider.name }} {
    remote-hostname "{{ provider.tls_hostname }}";
};
{% endfor %}

options {
    directory "/var/cache/bind";
    listen-on { 127.0.0.1; {{ lan_ip }}; };
    listen-on-v6 { none; };
    allow-query { localhost; {{ lan_cidr }}; };
    allow-recursion { localhost; {{ lan_cidr }}; };
    allow-transfer { none; };
    recursion yes;
    minimal-responses yes;
    dnssec-validation auto;
    version "not-disclosed";

    forward only;
    forwarders {
{% for provider in dns_upstream_providers %}
{% for address in provider.addresses %}
        {{ address }} port 853 tls dot-{{ provider.name }};
{% endfor %}
{% endfor %}
    };
};

logging {
    category lame-servers { null; };
};
