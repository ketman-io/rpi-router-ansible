default-lease-time {{ dhcp_default_lease_time }};
max-lease-time {{ dhcp_max_lease_time }};
authoritative;

# The network address and netmask come straight from lan_cidr/lan_netmask —
# not hard-coded. A previous version of this template hard-coded
# `netmask 255.255.248.0` and a 192.168.9.x range regardless of the site's
# real network, which broke isc-dhcp-server outright on any site not shaped
# like a /21 at 192.168.8.0 (confirmed: dhcpd's own self-test refused to
# start it at all — "not the correct network for the specified netmask").
subnet {{ lan_cidr.split('/')[0] }} netmask {{ lan_netmask }} {
    range {{ dhcp_range_start }} {{ dhcp_range_end }};
    option routers {{ lan_ip }};
    option subnet-mask {{ lan_netmask }};
    option domain-name-servers {{ lan_ip }};
}
